{
    // keep ruff from indexing the jinja-templated pyproject.toml (no braces: they’re glob syntax)
    "ruff.exclude": ["*cookiecutter.project_name*"],
    "[python][json][jsonc][yaml][markdown]": {
        "editor.formatOnSave": true,
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "[json][jsonc][yaml]": {
        "editor.defaultFormatter": "biomejs.biome",
    },
    "[markdown]": {
        "editor.defaultFormatter": "jolars.panache",
    },
}
